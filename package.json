import express from 'express';
import { default as makeWASocket, useMultiFileAuthState, Browsers } from '@whiskeysockets/baileys';
import pino from 'pino';
import fs from 'fs';
import path from 'path';

const app = express();
app.use(express.json());
app.use(express.urlencoded({ extended: true }));
const PORT = process.env.PORT || 3000;

app.get('/', (req, res) => {
  res.send(`
  <!DOCTYPE html>
  <html>
  <head>
    <title>ARSLAN-MD | Pair Site</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      body { background: #0a0a0a; color: white; font-family: Arial; text-align: center; padding: 20px; }
      .box { background: #1a1a1a; border: 2px solid #00ff00; border-radius: 20px; padding: 25px; max-width: 400px; margin: 30px auto; box-shadow: 0 0 20px #00ff00; }
      h1 { color: #00ff00; font-size: 28px; margin-bottom: 5px; }
      p { color: #aaa; font-size: 14px; }
      input { width: 90%; padding: 14px; margin: 15px 0; border-radius: 10px; border: none; font-size: 16px; text-align: center; outline: none; }
      button { background: #00ff00; color: black; padding: 14px 30px; border: none; border-radius: 10px; font-size: 17px; font-weight: bold; cursor: pointer; width: 95%; }
      .code-box { background: #000; border: 1px dashed #00ff00; padding: 15px; margin-top: 20px; border-radius: 10px; word-break: break-all; font-size: 13px; text-align: left; display: none; }
      .pair-code { font-size: 32px; letter-spacing: 5px; color: #00ff00; font-weight: bold; margin: 10px 0; }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>ARSLAN MD</h1>
      <p>Powered By MR ARSLAN</p>
      <p>Apna WhatsApp Number Likho<br>(0 ke baghair - Jaise 923001234567)</p>
      <input type="number" id="num" placeholder="923001234567" />
      <button onclick="getCode()">GET PAIR CODE</button>
      <div id="result" class="code-box"></div>
      <div style="margin-top:20px; font-size:12px; color:#555;">© 2026 ARSLAN-MD</div>
    </div>
    <script>
      async function getCode(){
        let num = document.getElementById('num').value;
        if(!num){ alert('Pehle Number Likho!'); return; }
        document.getElementById('result').style.display = 'block';
        document.getElementById('result').innerHTML = '⏳ Pair Code Ban Raha Hai... Thora Wait Karo...';
        let res = await fetch('/pair?num=' + num);
        let data = await res.json();
        if(data.code){
          document.getElementById('result').innerHTML = '<p>Apna Ye Code WhatsApp Me Daalo:</p><div class="pair-code">'+data.code+'</div><p>WhatsApp > Linked Devices > Link a Device > Link with phone number instead</p><p style="color:#00ff00;">Code Dalne Ke Baad 15 Sec Wait Karo, Session ID Yahan Aa Jayegi...</p><div id="sess"></div>';
          let check = setInterval(async ()=>{
            let r2 = await fetch('/session?num=' + num);
            let d2 = await r2.json();
            if(d2.session){
              clearInterval(check);
              document.getElementById('sess').innerHTML = '<p style="color:#00ff00; font-weight:bold;">SESSION ID MIL GAYI! Copy Kar Lo:</p><textarea style="width:100%; height:120px; background:#111; color:#fff; border-radius:10px; padding:10px;">'+d2.session+'</textarea><br><button onclick="copySess()">COPY SESSION</button>';
              window.mySession = d2.session;
            }
          }, 3000);
        } else {
          document.getElementById('result').innerHTML = '❌ Error: ' + (data.error || 'Dobara Try Karo');
        }
      }
      function copySess(){
        navigator.clipboard.writeText(window.mySession);
        alert('Session Copy Ho Gayi!');
      }
    </script>
  </body>
  </html>
  `);
});

let sessions = {};

app.get('/pair', async (req, res) => {
  let num = req.query.num;
  if (!num) return res.json({ error: 'Number nahi diya' });
  num = num.replace(/[^0-9]/g, '');

  try {
    let dir = './pair_' + num;
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    const { state, saveCreds } = await useMultiFileAuthState(dir);

    const sock = makeWASocket({
      logger: pino({ level: 'silent' }),
      printQRInTerminal: false,
      auth: state,
      browser: Browsers.macOS('Chrome'),
    });

    sock.ev.on('creds.update', saveCreds);

    sock.ev.on('connection.update', async (update) => {
      const { connection } = update;
      if (connection === 'open') {
        try {
          let credsPath = path.join(dir, 'creds.json');
          if (fs.existsSync(credsPath)) {
            let credsData = fs.readFileSync(credsPath);
            let b64 = Buffer.from(credsData).toString('base64');
            sessions[num] = 'ARSLAN-MD_' + b64;
            console.log('Session ban gayi: ' + num);
          }
        } catch (e) { console.log(e); }
      }
    });

    await new Promise(r => setTimeout(r, 2000));
    if (!sock.authState.creds.registered) {
      let code = await sock.requestPairingCode(num);
      return res.json({ code: code });
    } else {
      return res.json({ error: 'Ye number pehle se linked hai' });
    }
  } catch (err) {
    console.log(err);
    return res.json({ error: err.message });
  }
});

app.get('/session', (req, res) => {
  let num = req.query.num;
  if (sessions[num]) {
    return res.json({ session: sessions[num] });
  } else {
    return res.json({ session: null });
  }
});

app.listen(PORT, () => {
  console.log('ARSLAN-MD Pair Site Chal Rahi Hai - Port: ' + PORT);
});
